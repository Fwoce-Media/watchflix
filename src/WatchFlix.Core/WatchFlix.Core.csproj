<Project Sdk="Microsoft.NET.Sdk">

  <!-- The library itself: database, scanning, scraping and ffmpeg work.
       No NuGet packages at all — SQLite is reached directly (see Sqlite.cs), so
       this builds anywhere the .NET 8 SDK is installed. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WatchFlix.Core</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

</Project>
